# Fake example configuration. Copy to .env and edit for your local machine.
# OpenCode prompts, sessions, manifests, database paths, and tokens can be private.

# HTTP submission. The password value below is a placeholder.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
OPENCODE_MODEL=example/default-model
# Optional. Use only with a bare OPENCODE_MODEL, never together with provider/model.
# OPENCODE_PROVIDER=example
OPENCODE_AGENT=example-agent
OPENCODE_MESSAGE_TIMEOUT=3600

# --- Server topology (authoritative reference) ---
# This file is the source of truth for OpenCode server config now that the old
# start_opencode.sh has been removed. Two servers run in parallel, each with its
# own SQLite DB so they don't interfere:
#   main  -> port 4096, OPENCODE_DB=opencode.db        (recent real conversations)
#   batch -> port 4097, OPENCODE_DB=opencode_batch.db  (archived batch sessions)
# username is `opencode`; the server password comes from OPENCODE_SERVER_PASSWORD.
#
# OPERATIONAL RULE (do not violate): the user runs these servers themselves and
# keeps them running. An agent must NEVER start or restart them. Check liveness by
# port listener only (`lsof -nP -iTCP:4096 -sTCP:LISTEN`), NOT by /health (this
# build has no such route). Verify connectivity with `opencode_skill submit
# --dry-run` (a harmless probe). If a port is genuinely not listening, stop and
# ask the user to start it. The removed start_opencode.sh unconditionally killed
# the running server before restarting, cutting off in-flight sessions; do not
# recreate that behavior.

# SQLite maintenance.
OPENCODE_MAIN_DB=~/.local/share/opencode/opencode.db
OPENCODE_ARCHIVE_DB=~/.local/share/opencode/opencode_archive.db
OPENCODE_OLD_ARCHIVE_DB=~/.local/share/opencode/archive/old_sessions.db

# Optional: path used by CLI workflows that initialize a new archive DB from a schema-only template.
OPENCODE_EMPTY_TEMPLATE_DB=tests/fixtures/empty_opencode.db
